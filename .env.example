# API Configuration
# In production (cPanel), leave this empty to use same-origin /api
# In development, set to your PHP server URL (e.g. http://localhost:8080/api)
VITE_API_BASE_URL=

# Search engine ownership tokens (optional; public meta tags, not secrets)
VITE_GOOGLE_SITE_VERIFICATION=
VITE_BING_SITE_VERIFICATION=

# Supabase (legacy - no longer required for MySQL)
# VITE_PUBLIC_SUPABASE_URL=
# VITE_PUBLIC_SUPABASE_ANON_KEY=